{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Mode": "Local",
    "MetadataProvider": "InMemory",
    "BlobProvider": "Local",
    "AzureBlobContainer": "uploads",
    "S3Region": "us-east-1",
    "Redis": {
      "RedisConnection": "localhost:6379",
      "RedisKeyPrefix": "chunk-upload"
    }
  }
}
